{
  "name": "devkit",
  "private": true,
  "description": "Offline developer workbench with bundled Chromium",
  "author": {
    "name": "suyh1",
    "email": "suyhem@163.com"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://github.com/suyh1/DevKit",
  "version": "2.5.0",
  "type": "module",
  "scripts": {
    "docs:update": "node scripts/update-readme.mjs",
    "docs:check": "node scripts/update-readme.mjs --check",
    "test:docs": "node --test scripts/update-readme.check.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:java": "node scripts/check-java.mjs",
    "prepare:ssh-node": "node scripts/stage-ssh-node.mjs",
    "desktop": "npm run build && node scripts/start-desktop.mjs",
    "bundle:windows": "npm run build && node scripts/package-desktop.mjs --platform=win32 --arch=x64 --format=nsis",
    "bundle:linux": "npm run build && node scripts/package-desktop.mjs --platform=linux --arch=x64 --format=deb",
    "bundle:linux:arm64": "npm run build && node scripts/package-desktop.mjs --platform=linux --arch=arm64 --format=deb",
    "bundle:kylin": "npm run bundle:linux:arm64",
    "bundle:host": "npm run build && node scripts/package-desktop.mjs",
    "test:desktop": "npm run prepare:ssh-node && node --test electron/policy.check.cjs electron/desktop-preferences.check.cjs server/ssh-management.check.mjs server/lan-workspaces.check.mjs",
    "test:electron": "npm run build && node scripts/smoke-desktop.mjs",
    "bundle:all": "npm run build && node scripts/package-all.mjs",
    "clean:artifacts": "node scripts/clean-artifacts.mjs",
    "test:release": "node --test scripts/release-integrity.check.mjs scripts/generate-release-notes.check.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:git": "node --test server/git-workspace.check.mjs server/git-workflows.check.mjs",
    "test:projects": "node --test server/projects.check.mjs",
    "test:nginx": "node --test server/nginx.check.mjs server/nginx-inspection.check.mjs",
    "test:monitor": "node --test server/monitor.check.mjs",
    "test:logs": "node --test server/log-center.check.mjs",
    "test:jar": "node --test server/backend.check.mjs server/jar.check.mjs server/jar-policies.check.mjs server/jar-supervisor.check.mjs server/jar-console.check.mjs server/jar-sharing.check.mjs",
    "serve:projects": "npm run prepare:ssh-node && node server/start.mjs",
    "bundle:project-server": "npm run build && node scripts/package-project-server.mjs",
    "test:http": "node --test server/http-client.check.mjs server/api-workspace.check.mjs server/workspace-sharing.check.mjs server/sharing-policy.check.mjs server/lan-rdp.check.mjs server/planning-sharing.check.mjs server/git-workspace.check.mjs server/git-workflows.check.mjs server/collaboration.check.mjs",
    "test:portal": "npm run build && node scripts/smoke-portal.mjs"
  },
  "dependencies": {
    "@babel/parser": "^8.0.8",
    "@cfworker/json-schema": "4.1.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@faker-js/faker": "^10.6.0",
    "@formatjs/icu-messageformat-parser": "^3.5.23",
    "@headlessui/react": "^2.2.10",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@lezer/highlight": "^1.2.5",
    "@noble/hashes": "2.4.0",
    "@oddbird/popover-polyfill": "^0.7.3",
    "@peculiar/x509": "^3.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "buffer": "^6.0.3",
    "codemirror": "^6.0.2",
    "cron-parser": "^5.10.6",
    "diff": "^9.0.0",
    "exceljs": "^4.4.0",
    "fast-json-patch": "^3.1.2",
    "file-type": "^22.3.0",
    "fzstd": "^0.1.1",
    "geographiclib-dms": "2.2.0",
    "geographiclib-geodesic": "2.2.0",
    "hyparquet": "^1.33.1",
    "hyparquet-compressors": "^1.1.3",
    "iconv-lite": "^0.7.3",
    "ignore": "^7.0.16",
    "java-parser": "^3.0.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "markdown-it": "14.3.3",
    "mermaid": "^12.3.0",
    "node-diff3": "^4.0.0",
    "pixelmatch": "^8.0.0",
    "prettier": "^3.9.10",
    "protobufjs": "^8.8.1",
    "qrcode-generator": "2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rrule": "^2.8.1",
    "semver": "7.8.5",
    "smol-toml": "^1.9.1",
    "sql-formatter": "^15.9.0",
    "ssh2": "^1.17.0",
    "svgo": "^4.1.0",
    "tldts": "^7.5.5",
    "xml-formatter": "^3.7.0",
    "yaml": "^2.9.1",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/markdown-it": "14.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "hyparquet-writer": "^0.18.0",
    "jsqr": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "exceljs": { "uuid": "11.1.1" },
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1"
  }
}
