{
  "name": "devkit",
  "private": true,
  "description": "Offline developer workbench with bundled Chromium",
  "author": "DevKit maintainers",
  "version": "1.10.3",
  "type": "module",
  "scripts": {
    "docs:update": "node scripts/update-readme.mjs",
    "docs:check": "node scripts/update-readme.mjs --check",
    "test:docs": "node --test scripts/update-readme.check.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:java": "node scripts/check-java.mjs",
    "desktop": "npm run build && node scripts/start-desktop.mjs",
    "bundle:windows": "npm run build && node scripts/package-desktop.mjs --platform=win32 --arch=x64 --format=nsis",
    "bundle:linux": "npm run build && node scripts/package-desktop.mjs --platform=linux --arch=x64 --format=deb",
    "bundle:linux:arm64": "npm run build && node scripts/package-desktop.mjs --platform=linux --arch=arm64 --format=deb",
    "bundle:kylin": "npm run bundle:linux:arm64",
    "bundle:host": "npm run build && node scripts/package-desktop.mjs",
    "test:desktop": "node --test electron/policy.check.cjs",
    "test:electron": "npm run build && node scripts/smoke-desktop.mjs",
    "bundle:all": "npm run build && node scripts/package-all.mjs",
    "test:release": "node --test scripts/release-integrity.check.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:projects": "node --test server/projects.check.mjs",
    "test:nginx": "node --test server/nginx.check.mjs",
    "serve:projects": "node server/start.mjs",
    "bundle:project-server": "npm run build && node scripts/package-project-server.mjs"
  },
  "dependencies": {
    "@babel/parser": "^8.0.8",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "geographiclib-dms": "2.2.0",
    "geographiclib-geodesic": "2.2.0",
    "java-parser": "^3.0.1",
    "lucide-react": "^0.468.0",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql-formatter": "^15.9.0",
    "xml-formatter": "^3.7.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1"
  }
}
